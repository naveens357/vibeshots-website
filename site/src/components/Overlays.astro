---
import { waLink, tel } from '../lib/format';
import site from '../data/site.json';
---
<nav class="mbar" aria-label="Quick actions">
  <a href={waLink()} target="_blank" rel="noopener"><svg width="18" height="18"><use href="#i-wa"/></svg>WhatsApp</a>
  <a href={tel(site.phonePrimary)}><svg width="18" height="18"><use href="#i-phone"/></svg>Call</a>
  <button type="button" data-check><svg width="18" height="18"><use href="#i-cal"/></svg>Check date</button>
</nav>

<div class="modal" id="checkModal" role="dialog" aria-modal="true" aria-labelledby="mTitle">
  <div class="box">
    <button class="x" type="button" aria-label="Close" data-close><svg width="16" height="16" style="margin:auto"><use href="#i-close"/></svg></button>
    <span class="deva" lang="ne">साइत</span>
    <h2 class="h3" id="mTitle" style="font-size:32px">Check your date</h2>
    <p class="muted small" style="margin:6px 0 20px">Enter your date in BS or AD. We confirm on WhatsApp.</p>
    <form class="form" style="grid-template-columns:1fr" data-checkform data-wa={site.whatsapp}>
      <div class="fld"><label for="m1">Wedding date</label><input id="m1" name="date" placeholder="e.g. 18 Mangsir 2083 or 4 Dec 2026" required></div>
      <div class="fld"><label for="m2">City / venue</label><input id="m2" name="city" placeholder="e.g. Bhaktapur" required></div>
      <button class="btn btn-dot block" type="submit"><span class="dot"><svg><use href="#i-arrow"/></svg></span><span class="lbl">Check availability</span></button>
    </form>
    <div class="result" id="mRes" aria-live="polite"></div>
  </div>
</div>

<div class="modal film-modal" id="filmModal" role="dialog" aria-modal="true" aria-label="Film">
  <div class="box">
    <button class="x" type="button" aria-label="Close film" data-close><svg width="16" height="16" style="margin:auto"><use href="#i-close"/></svg></button>
    <div data-film-slot style="width:100%;height:100%"></div>
  </div>
</div>
