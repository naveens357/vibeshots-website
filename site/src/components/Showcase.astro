---
/** List and detail views for Pre-weddings. */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Media from './Media.astro';
import Gallery from './Gallery.astro';
import SectionTitle from './SectionTitle.astro';
import { coverProps } from '../lib/media';
import ArrowLink from './ArrowLink.astro';
type Entry = CollectionEntry<'prewedding'>;
interface Props { base: string; items?: Entry[]; entry?: Entry }
const { base, items = [], entry } = Astro.props;
const Content = entry ? (await render(entry)).Content : null;
---
{entry && Content ? (
  <>
    <section class="sec" style="padding-top:96px;padding-bottom:48px">
      <div class="wrap">
        <SectionTitle as="h1" title={entry.data.title} text={entry.data.location} />
        <div style="max-width:1100px;margin:0 auto">
          <Media {...coverProps(entry.data, entry.data.title)} ratio="32" eager />
        </div>
      </div>
    </section>
    <section class="sec tight"><div class="wrap"><div class="prose center"><Content /></div></div></section>
    <Gallery items={entry.data.gallery} style="max-width:1100px" />
    <section class="sec center">
      <div class="wrap row-btns" style="justify-content:center;gap:40px">
        <a class="link-caps" href={base}>← Back</a>
        <ArrowLink href="/contact/">Plan yours</ArrowLink>
      </div>
    </section>
  </>
) : (
  <div class="plist">
    {items.map((it) => (
      <a class="pitem rv" href={`${base}${it.id}/`}>
        <Media {...coverProps(it.data, it.data.title)} />
        <h3>{it.data.title}</h3>
        {it.data.location && <p class="where">{it.data.location}</p>}
        {it.data.excerpt && <p>{it.data.excerpt}</p>}
      </a>
    ))}
  </div>
)}
