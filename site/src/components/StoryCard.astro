---
/** Story card: square photo, phrase title, couple names, month · city, short teaser. */
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import { coverProps } from '../lib/media';
import { formatDate } from '../lib/dates';
interface Props { story: CollectionEntry<'stories'> }
const { story } = Astro.props;
const d = story.data;
---
<a class="scard bw rv" href={`/weddings/${story.id}/`}>
  <Media {...coverProps(d, `${d.title} wedding`)} />
  <h3>{d.headline || d.title}</h3>
  {d.headline && <p class="who">{d.title}</p>}
  <p class="where">{[d.dateBS || formatDate(d.date, 'monthYear'), d.city || d.venue].filter(Boolean).join(' · ')}</p>
  {d.excerpt && <p>{d.excerpt}</p>}
</a>
