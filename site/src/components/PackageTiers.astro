---
import packages from '../data/packages.json';
import { np, earlyBird, waPackage } from '../lib/format';
interface Props { full?: boolean }
const { full = false } = Astro.props;
const sides = ['bride', 'groom', 'both'] as const;
const sideLabel = { bride: 'bride side', groom: 'groom side', both: 'both families' };
---
<div class="tiers" data-side-scope data-side="bride">
  {packages.tiers.map((t) => (
    <article class:list={['tier rv', { pop: t.popular }]}>
      {t.popular && <span class="badge">Most popular</span>}
      <div>
        <span class="deva" lang="ne" style="font-size:18px;margin:0">{t.deva}</span>
        <h3 class="nm">{t.name}</h3>
        <p class="sub">{t.label}</p>
      </div>
      {sides.map((s) => (
        <div class={`s-${s}`}>
          <div class="price"><small>NPR</small>{np(t[s].price)}</div>
          <p class="was">Sum of events <s>{np(t[s].sum)}</s> · you save {np(t[s].sum - t[s].price)}</p>
          <p class="eb">Early bird: NPR {np(earlyBird(t[s].price))}</p>
        </div>
      ))}
      {(['bride', 'both'] as const).map((s) => {
        const list = s === 'both' ? t.bothIncludes : t.includes;
        // bride and groom share one list; "both" has its own
        return <ul class={s === 'both' ? 's-both' : 's-one'}>{(full ? list : list.slice(0, 4)).map((i) => <li>{i}</li>)}</ul>;
      })}
      {/* phones show the first 3 inclusions; this reveals the rest */}
      <button class="tier-more" type="button" aria-expanded="false" data-tier-more>See all inclusions</button>
      <div class="ctas">
        <button class="btn btn-dot" type="button" data-check><span class="dot"><svg><use href="#i-arrow"/></svg></span><span class="lbl">Check your date</span></button>
        {sides.map((s) => (
          <a class={`btn btn-wa s-${s}`} href={waPackage(`${t.name} (${sideLabel[s]})`)} target="_blank" rel="noopener" aria-label={`Ask about ${t.name} on WhatsApp`}><svg><use href="#i-wa"/></svg><span class="wa-text">Ask on WhatsApp</span></a>
        ))}
      </div>
    </article>
  ))}
</div>
<div class="tier-dots" data-tier-dots role="tablist" aria-label="Packages">
  {packages.tiers.map((t, i) => <button type="button" role="tab" aria-label={`Show ${t.name}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}
  <span class="hint" aria-hidden="true">Swipe</span>
</div>
