---
/** Small Google map of the studio with a name card and directions buttons. Loads lazily. */
import site from '../data/site.json';
import { mapEmbed, mapDirections } from '../lib/format';
interface Props { variant?: 'card' | 'footer'; class?: string; style?: string }
const { variant = 'card', class: cls = '', style } = Astro.props;
---
<div class:list={['minimap', `minimap--${variant}`, cls]} style={style}>
  <iframe
    src={mapEmbed(variant === 'footer' ? site.mapZoom - 1 : site.mapZoom)}
    title={`Map: ${site.name}, ${site.address}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  {variant === 'card' ? (
    <div class="minimap-card">
      <span class="minimap-pin" aria-hidden="true"><svg width="18" height="18"><use href="#i-pin"/></svg></span>
      <div>
        <b>{site.name} studio</b>
        <small>{site.address}</small>
      </div>
      <div class="minimap-acts">
        <a class="btn btn-dot sm" href={mapDirections()} target="_blank" rel="noopener"><span class="dot"><svg><use href="#i-arrow"/></svg></span><span class="lbl">Directions</span></a>
        <a class="btn btn-wa sm" href={site.mapUrl} target="_blank" rel="noopener">Open in Maps</a>
      </div>
    </div>
  ) : (
    <a class="minimap-open" href={site.mapUrl} target="_blank" rel="noopener">Open in Google Maps ↗</a>
  )}
</div>
