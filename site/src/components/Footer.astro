---
import site from '../data/site.json';
import { waLink, viberLink, igProfile, tel } from '../lib/format';
import MiniMap from './MiniMap.astro';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap">
    <div class="grid">
      <div>
        <img class="logo" src="/images/logo-light.png" alt={site.name} width="220" height="62">
        <p style="max-width:34ch">{site.description}</p>
        <div class="icons">
          <a class="icon-btn" href={igProfile()} aria-label="Instagram (weddings)" target="_blank" rel="noopener"><svg width="18" height="18"><use href="#i-ig"/></svg></a>
          <a class="icon-btn" href={waLink()} aria-label="WhatsApp" target="_blank" rel="noopener"><svg width="18" height="18"><use href="#i-wa"/></svg></a>
          <a class="icon-btn" href={viberLink()} aria-label="Viber"><svg width="18" height="18"><use href="#i-viber"/></svg></a>
        </div>
      </div>
      <div>
        <h2>Weddings</h2>
        <ul>
          <li><a href="/weddings/">Stories</a></li>
          <li><a href="/films/">Films</a></li>
          <li><a href="/images/">Images</a></li>
          <li><a href="/albums/">Albums</a></li>
          <li><a href="/pre-weddings/">Pre-weddings</a></li>
          <li><a href="/weddings/#ceremonies">Ceremonies</a></li>
        </ul>
      </div>
      <div>
        <h2>Studio</h2>
        <ul>
          <li><a href="/packages/">Packages</a></li>
          <li><a href="/commercial/">Commercial</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/journal/">Journal</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Visit</h2>
        <ul>
          <li><a href={site.mapUrl} target="_blank" rel="noopener">{site.address}</a></li>
          <li><a href={tel(site.phonePrimary)}>{site.phonePrimary}</a> / <a href={tel(site.phoneSecondary)}>{site.phoneSecondary}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={igProfile(site.instagramWeddings)} target="_blank" rel="noopener">@{site.instagramWeddings}</a> · <a href={igProfile(site.instagramCommercial)} target="_blank" rel="noopener">@{site.instagramCommercial}</a></li>
        </ul>
        <MiniMap variant="footer" />
      </div>
    </div>
    <p class="bye" lang="ne">धन्यवाद</p>
    <div class="legal"><span>© {year} {site.name}</span><span>{site.address}</span></div>
  </div>
</footer>
