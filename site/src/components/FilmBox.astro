---
/** Film poster with a play button; the film opens in the film modal (scripts/features/modals.ts). */
import Media from './Media.astro';
interface Props {
  film: string;
  poster: string;
  alt?: string;
  tone?: string;
  label?: string;
  sizes?: string;
  class?: string;
}
const { film, poster, alt, tone = 'night', label = 'Film', sizes, class: cls } = Astro.props;
---
<div class:list={['filmbox', cls]}>
  <Media src={poster} alt={alt} tone={tone} label={label} ratio="169" sizes={sizes} />
  <button class="btn btn-shutter" type="button" data-film={film} aria-label="Play film"><svg><use href="#i-aperture"/></svg></button>
</div>
