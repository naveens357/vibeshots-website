---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import PBanner from '../components/PBanner.astro';
import StoryCard from '../components/StoryCard.astro';
import PackageTiers from '../components/PackageTiers.astro';
import SideToggle from '../components/SideToggle.astro';
import Team from '../components/Team.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import { waLink } from '../lib/format';

const stories = (await getCollection('stories')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date).slice(0, 3);
const t = site.testimonials[0];
---
<Base title={site.name} headerOver>
  <PBanner variant="hero" as="h1" title={home.welcomeTitle} text={home.welcomeLines} deva="नमस्ते" src={home.heroImage} video={home.heroVideo} tone="bride" label="Hero photo or 20–30 s loop · couple in red saree, Bhaktapur golden hour" eager>
    <div slot="foot" class="hero-foot">
      <span class="scroll-cue" aria-hidden="true">Scroll<i></i></span>
      <a href="/commercial/">Commercial work <span aria-hidden="true">→</span></a>
    </div>
  </PBanner>

  <section class="sec">
    <div class="wrap quote rv">
      <blockquote>“{home.quote}”</blockquote>
      <cite>— {home.quoteBy}</cite>
    </div>
  </section>

  {home.blocks.map((b) => (
    <>
      <PBanner title={b.title} src={b.image} tone={b.tone} bw label="Black-and-white banner photo" />
      <section class="sec manifesto"><div class="wrap rv">{b.text.split('\n').map((p) => <p>{p}</p>)}</div></section>
    </>
  ))}

  <div class="orn"><i></i></div>

  <section class="sec">
    <div class="wrap">
      <div class="stitle rv"><span class="deva" lang="ne">विवाह कथाहरू</span><h2>Stories</h2><p>Delve into the weddings we've been part of.</p></div>
      <div class="sgrid">{stories.map((s) => <StoryCard story={s} />)}</div>
      <p class="center" style="margin-top:56px"><a class="link-caps" href="/weddings/">All stories <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="sec tight">
    <div class="wrap door-split">
      <a class="door-mini rv" href="/films/">
        <Media tone="night" label="Film still" />
        <span class="cap"><b>Films</b><span>Reels, highlights and full wedding films</span></span>
      </a>
      <a class="door-mini rv" href="/commercial/">
        <Media tone="moto" label="Motorsport still" />
        <span class="cap"><b>Commercial</b><span>Motorsport, travel and brands</span></span>
      </a>
    </div>
  </section>

  <section class="sec" style="background:var(--paper)">
    <div class="wrap">
      <div class="stitle rv"><span class="deva" lang="ne">प्याकेजहरू</span><h2>Packages</h2><p>Kathmandu Valley prices in NPR · 5% early-bird when booked 90+ days ahead</p></div>
      <div class="center" style="margin:-24px 0 40px"><SideToggle /></div>
      <PackageTiers />
      <p class="center" style="margin-top:48px"><a class="link-caps" href="/packages/">All packages, add-ons &amp; travel <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <Team link bio={false} />

  {t && (
    <section class="sec tight">
      <div class="wrap quote rv">
        <div class="stars" aria-label="5 stars">★★★★★</div>
        <blockquote>“{t.quote}”</blockquote>
        <cite>{t.name}{t.detail && ` · ${t.detail}`}</cite>
      </div>
    </section>
  )}

  <section class="sec" style="border-top:1px solid var(--line)">
    <div class="wrap center rv">
      <div class="stitle" style="margin-bottom:28px"><span class="deva" lang="ne">साइत तय भयो?</span><h2>Let's talk</h2><p>Tell us your date, and we'll reply within 2 hours.</p></div>
      <div class="row-btns">
        <button class="btn btn-dot" type="button" data-check><span class="dot"><svg><use href="#i-arrow"/></svg></span><span class="lbl">Check your date</span></button>
        <a class="btn btn-wa" href={waLink("Namaste Vibeshots, we'd like to check our wedding date")} target="_blank" rel="noopener"><svg><use href="#i-wa"/></svg>WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
