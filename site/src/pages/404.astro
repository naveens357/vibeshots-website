---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="phero" style="padding:140px 0">
    <div class="wrap narrow">
      <span class="deva" lang="ne">माफ गर्नुहोस्</span>
      <h1 class="h-l">This page <span class="it">wandered off.</span></h1>
      <p class="lead">The link may be old, or the page has moved.</p>
      <div class="row-btns" style="justify-content:center">
        <a class="btn btn-dot" href="/"><span class="dot"><svg><use href="#i-arrow"/></svg></span><span class="lbl">Back to home</span></a>
        <a class="btn btn-line" href="/packages/"><span class="lbl">See packages</span></a>
      </div>
    </div>
  </section>
</Base>
