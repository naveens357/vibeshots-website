---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import StoryCard from '../../components/StoryCard.astro';
import { newestFirst } from '../../lib/content';
import { coverProps } from '../../lib/media';
import SectionTitle from '../../components/SectionTitle.astro';
import ArrowLink from '../../components/ArrowLink.astro';

const stories = await newestFirst('stories');
const ceremonies = (await getCollection('ceremonies')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Wedding Photography in Nepal: Real Wedding Stories" description="Hindu and Newari wedding photography and films in Bhaktapur, Kathmandu, Lalitpur and across Nepal. Real wedding stories by Vibeshots Nepal.">
  <section class="sec" style="padding-top:96px">
    <div class="wrap">
      <SectionTitle as="h1" deva="विवाह कथाहरू" title="Stories" text="Delve deeper into our world of storytelling." />
      <div class="sgrid">{stories.map((s) => <StoryCard story={s} />)}</div>
    </div>
  </section>

  <div class="orn"><i></i></div>

  <section class="sec" id="ceremonies">
    <div class="wrap">
      <SectionTitle deva="संस्कार" title="Ceremonies" text="From the first mehendi to the last bidaai." />
      <div class="cgrid-cer">
        {ceremonies.map((c) => (
          <a class="cer rv" href={`/weddings/ceremonies/${c.id}/`} style="text-align:center">
            <Media {...coverProps(c.data)} ratio="34" arch />
            <span class="deva" lang="ne">{c.data.deva}</span>
            <h3>{c.data.title}</h3>
            <p>{c.data.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tight center">
    <div class="wrap row-btns" style="justify-content:center;gap:40px">
      <ArrowLink href="/films/">Watch our films</ArrowLink>
      <ArrowLink href="/packages/">See packages</ArrowLink>
    </div>
  </section>
</Base>
