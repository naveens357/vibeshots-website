---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import StoryCard from '../../components/StoryCard.astro';

const stories = (await getCollection('stories')).sort((a, b) => +b.data.date - +a.data.date);
const ceremonies = (await getCollection('ceremonies')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Wedding Stories" description="Hindu and Newari wedding stories photographed and filmed by Vibeshots Nepal in Bhaktapur, Kathmandu, Lalitpur and across Nepal.">
  <section class="sec" style="padding-top:96px">
    <div class="wrap">
      <div class="stitle"><span class="deva" lang="ne">विवाह कथाहरू</span><h1>Stories</h1><p>Delve deeper into our world of storytelling.</p></div>
      <div class="sgrid">{stories.map((s) => <StoryCard story={s} />)}</div>
    </div>
  </section>

  <div class="orn"><i></i></div>

  <section class="sec" id="ceremonies">
    <div class="wrap">
      <div class="stitle"><span class="deva" lang="ne">संस्कार</span><h2>Ceremonies</h2><p>From the first mehendi to the last bidaai.</p></div>
      <div class="cgrid-cer">
        {ceremonies.map((c) => (
          <a class="cer rv" href={`/weddings/ceremonies/${c.id}/`} style="text-align:center">
            <Media src={c.data.cover} alt={c.data.coverAlt} tone={c.data.coverTone} label={c.data.coverLabel} ratio="34" arch />
            <span class="deva" lang="ne">{c.data.deva}</span>
            <h3>{c.data.title}</h3>
            <p>{c.data.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tight center">
    <div class="wrap row-btns" style="justify-content:center;gap:40px">
      <a class="link-caps" href="/films/">Watch our films <span aria-hidden="true">→</span></a>
      <a class="link-caps" href="/packages/">See packages <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
