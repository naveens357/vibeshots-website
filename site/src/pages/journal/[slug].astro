---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { absUrl, businessRef } from '../../lib/seo';
import FinalCta from '../../components/FinalCta.astro';
import { formatDate } from '../../lib/dates';
import { coverProps } from '../../lib/media';

export async function getStaticPaths() {
  const posts = await getCollection('journal', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const article = [{
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString(),
  ...(d.cover ? { image: absUrl(d.cover, Astro.site) } : {}),
  author: businessRef(Astro.site),
  publisher: businessRef(Astro.site),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
}];
const date = formatDate(d.date);
---
<Base title={d.seoTitle || d.title} description={d.seoDescription || d.excerpt} image={d.cover || undefined} schema={article}>
  <article>
    <header class="phero">
      <div class="wrap narrow">
        <p class="eyebrow">Journal · {date}</p>
        <h1 class="h-l" style="margin-top:16px">{d.title}</h1>
        <p class="lead">{d.excerpt}</p>
      </div>
    </header>
    <div class="wrap" style="max-width:1100px"><Media {...coverProps(d)} ratio="219" eager /></div>
    <section class="sec"><div class="wrap"><div class="prose"><Content /></div></div></section>
  </article>
  <FinalCta title="Planning your wedding?" accent="Let's talk." linkHref="/journal/" linkLabel="More from the journal" />
</Base>
