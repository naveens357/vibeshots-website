---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import CommercialBrief from '../../components/CommercialBrief.astro';
import site from '../../data/site.json';
import { sectors } from '../../lib/format';
const projects = (await getCollection('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date);
const services = [
  ['Campaign stills', 'Hero images for ads, billboards and launches.'],
  ['Brand films & TVC', 'Concept to colour grade. 4K, drone, gimbal and car rigs.'],
  ['Motorsport coverage', 'Race weekends with same-day selects for socials.'],
  ['Social content packs', 'Monthly reels and photo sets for brands.'],
  ['Travel & hospitality', 'Hotels, resorts and destinations, from rooms to reels.'],
  ['Events', 'Concerts, corporate events and aftermovies.'],
];
---
<Base title="Commercial Photography & Video Production in Nepal" description="Commercial photographers and filmmakers in Nepal: food and restaurant, motorsport, travel, product and brand photography and promo films, from Bhaktapur." dark headerOver>
  <div class="on-dark">
    <section class="chero">
      <Media video={site.heroCommercialVideo} poster={site.heroCommercialPoster} src={site.heroCommercialPoster} tone="moto" label="21:9 motion loop · motocross, rally, car rolling shot" eager />
      <div class="shade"></div>
      <div class="wrap in">
        {site.officialLine && <p class="official"><i></i>{site.officialLine}</p>}
        <h1 class="comm">Made in Bhaktapur.<br><span>Shot for the world.</span></h1>
        <div class="row-btns" style="margin-top:32px">
          <a class="btn btn-comm" href="#brief">Start a project<span class="blk"><svg width="16" height="16"><use href="#i-arrow"/></svg></span></a>
          {site.showreelUrl && <button class="btn btn-comm ghost" type="button" data-film={site.showreelUrl}>Watch showreel<span class="blk"><svg width="16" height="16"><use href="#i-arrow"/></svg></span></button>}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div class="filters">
          <div class="seg" data-seg="mode" role="group" aria-label="Stills or motion">
            <span class="pill" aria-hidden="true"></span>
            <button type="button" aria-pressed="true" data-mode="all">All</button>
            <button type="button" aria-pressed="false" data-mode="stills">Stills</button>
            <button type="button" aria-pressed="false" data-mode="motion">Motion</button>
          </div>
          <div class="fchips" role="group" aria-label="Sector">
            <button class="fchip" type="button" aria-pressed="true" data-f="all">All</button>
            {Object.entries(sectors).map(([k, v]) => <button class="fchip" type="button" aria-pressed="false" data-f={k}>{v}</button>)}
          </div>
        </div>
        <div class="pgrid">{projects.map((p, i) => <ProjectTile project={p} big={i === 0} filterable />)}</div>
        <p class="empty" data-empty>No projects in this filter yet.</p>
      </div>
    </section>

    {site.clients.length > 0 && (
      <section class="sec tight">
        <div class="wrap">
          <p class="eyebrow" style="margin-bottom:20px">Trusted by</p>
          <div class="logos">{site.clients.map((c) => <div>{c}</div>)}</div>
        </div>
      </section>
    )}

    <section class="sec tight">
      <div class="wrap">
        <h2 class="comm-m" style="margin-bottom:32px">What we make</h2>
        <div class="svc">{services.map(([h, t], i) => <div><div class="k">{String(i + 1).padStart(2, '0')}</div><h3>{h}</h3><p>{t}</p></div>)}</div>
      </div>
    </section>

    <CommercialBrief />
  </div>
</Base>
