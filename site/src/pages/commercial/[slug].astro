---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import Gallery from '../../components/Gallery.astro';
import FilmBox from '../../components/FilmBox.astro';
import { newestFirst } from '../../lib/content';
import { coverProps } from '../../lib/media';
import { sectors, projectType } from '../../lib/format';
import { videoSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await newestFirst('projects');
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, more: projects.filter((p) => p.id !== project.id).slice(0, 3) },
  }));
}
const { project, more } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const videos = d.film ? [videoSchema({ name: `${d.client}: ${d.title}`, description: d.credit || `${d.client}: ${d.title}. ${sectors[d.sector]} film by Vibeshots Nepal.`, url: d.film, poster: d.filmPoster || d.cover, date: d.date }, Astro.site)] : [];
const type = projectType(d.types);
---
<Base title={d.seoTitle || `${d.client} · ${d.title}`} description={d.seoDescription || d.credit || `${d.client}: ${d.title}. ${sectors[d.sector]} work by Vibeshots Nepal.`} image={d.cover || undefined} schema={videos} dark headerOver>
  <div class="on-dark">
    <section class="chero" style="min-height:min(78svh,720px)">
      <Media {...coverProps(d)} eager sizes="100vw" />
      <div class="shade"></div>
      <div class="wrap in">
        <p class="official"><i></i>{d.client} · {sectors[d.sector]}</p>
        <h1 class="comm" style="font-size:clamp(40px,6.4vw,104px)">{d.title}</h1>
        {d.credit && <p class="lead" style="margin-top:16px;color:#ccc">{d.credit}</p>}
      </div>
    </section>

    <div class="wrap">
      <div class="facts">
        <div><small>Client</small><b>{d.client}</b></div>
        <div><small>Type</small><b>{type}</b></div>
        <div><small>Location</small><b>{d.location || '—'}</b></div>
        <div><small>Delivered</small><b>{d.deliverables || '—'}</b></div>
      </div>
    </div>

    <section class="sec"><div class="wrap"><div class="prose"><Content /></div></div></section>

    {d.film && (
      <div class="wrap" style="margin-bottom:12px;max-width:1100px">
        <FilmBox film={d.film} poster={d.filmPoster || d.cover} alt={`${d.client} film`} tone="moto" sizes="100vw" />
      </div>
    )}

    <Gallery items={d.gallery} />

    {d.results && (
      <section class="sec tight" style="padding-top:72px">
        <div class="wrap"><p class="eyebrow">Results</p><p class="comm-m" style="margin-top:12px">{d.results}</p></div>
      </section>
    )}

    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <h2 class="comm-m">More work</h2>
          <a class="btn btn-comm" href="/commercial/#brief">Start a project<span class="blk"><svg width="16" height="16"><use href="#i-arrow"/></svg></span></a>
        </div>
        <div class="cgrid">{more.map((p) => <ProjectTile project={p} />)}</div>
      </div>
    </section>
  </div>
</Base>
