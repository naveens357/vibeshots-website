---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Showcase from '../../components/Showcase.astro';
export async function getStaticPaths() {
  return (await getCollection('prewedding')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Base title={entry.data.seoTitle || `${entry.data.title} · Pre-wedding`} description={entry.data.seoDescription || entry.data.excerpt} image={entry.data.cover || undefined}>
  <Showcase base="/pre-weddings/" entry={entry} />
</Base>
