---
import Base from '../../layouts/Base.astro';
import Showcase from '../../components/Showcase.astro';
import { newestFirst } from '../../lib/content';
import SectionTitle from '../../components/SectionTitle.astro';
const items = await newestFirst('prewedding');
---
<Base title="Pre-wedding Photoshoot in Nepal" description="Pre-wedding and engagement photo shoots in Bhaktapur Durbar Square, Patan, Nagarkot, Pokhara and across Nepal by Vibeshots Nepal.">
  <section class="sec" style="padding-top:96px">
    <div class="wrap">
      <SectionTitle as="h1" deva="प्रि-वेडिङ" title="Pre-weddings" text="Durbar squares, mountain sunrises and lakes at golden hour." />
      <Showcase base="/pre-weddings/" items={items} />
    </div>
  </section>
</Base>
