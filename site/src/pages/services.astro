---
import Base from '../layouts/Base.astro';
import services from '../data/services.json';
import site from '../data/site.json';
import packages from '../data/packages.json';
import { waLink } from '../lib/format';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ArrowLink from '../components/ArrowLink.astro';
const zoneText = (z: { travel: string; coverage: string }) =>
  (z.travel === 'Included' ? 'Travel included in every package.' : z.travel.replace(/([^.…])$/, '$1.')) + (z.coverage.startsWith('+') ? ` Coverage ${z.coverage}.` : '');
---
<Base title="Photography & Film Services in Bhaktapur, Nepal" description="Wedding photography, wedding videography, pre-wedding, maternity and commercial photography services by Vibeshots Nepal in Bhaktapur, Kathmandu and across Nepal.">
  <section class="phero">
    <div class="wrap">
      <span class="deva" lang="ne">सेवाहरू</span>
      <h1 class="h-l">Photography &amp; film services</h1>
      <p class="lead">{services.intro}</p>
      {services.introNe && <p class="lead ne" lang="ne">{services.introNe}</p>}
    </div>
  </section>

  {services.groups.map((g) => (
    <section class="sec tight">
      <div class="wrap">
        <SectionTitle reveal deva={g.deva} title={g.title} />
        <div class="steps svc-list">
          {g.items.map((s, i) => (
            <div class="step rv">
              <div class="n">{String(i + 1).padStart(2, '0')}</div>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
              <ArrowLink href={s.link}>{s.linkText}</ArrowLink>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="sec tight" id="areas">
    <div class="wrap">
      <SectionTitle reveal deva="कहाँ कहाँ" title="Where we shoot" text={`Studio in ${site.address}. Weddings and shoots across Nepal and beyond.`} />
      <div class="steps svc-list">
        {packages.zones.map((z) => (
          <div class="step rv">
            <div class="n">{z.code}</div>
            <h3>{z.name}</h3>
            <p><b>{z.places}</b></p>
            <p>{zoneText(z)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tight">
    <div class="wrap narrow center">
      <div class="row-btns" style="justify-content:center">
        <Button href="/contact/">Check your date</Button>
        <Button variant="line" href={waLink()} external>WhatsApp us</Button>
      </div>
    </div>
  </section>
</Base>
